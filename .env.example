PORT=5000

# MongoDB Atlas credentials
DB_USER=your-db-user
DB_PASS=your-db-password
DB_NAME=winter-sdep

# Must match EVENTS_JWT_SECRET in the Next.js app's .env
JWT_SECRET=replace-with-a-long-random-secret
JWT_ISSUER=frosttogether-web
JWT_AUDIENCE=frosttogether-api

# Comma-separated browser origins allowed to call the API directly
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional: email of the user who should own the demo seed events
# SEED_OWNER_EMAIL=you@example.com
